# .gitignore cho dự án Python Flask

# Virtual environments
venv/
ENV/
env/

# Python bytecode và cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Log files
*.log

# File tạm của hệ điều hành và editor
.DS_Store
*.swp
*.swo
*.bak
*.tmp

# Database & migrations
*.sqlite
*.db
migrations/
instance/

# Ảnh và tài liệu tải lên
uploads/
static/uploads/
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.ico
*.webp
*.svg
*.pdf
*.docx
*.doc

# Flask specific
*.env
.env.*
config.py

# Node modules (nếu sử dụng frontend hoặc assets)
node_modules/